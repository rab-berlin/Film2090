F07 ; DF              RET
141 ; E0 punkt:       R1 = 4: Cursor 1 / Punkt
CEF ; E1
161 ; E2 rechteck:    R1 = 6: Rechteck Cursor 1 - Cursor 2
CEF ; E3
532 ; E4 f_magenta:   R2 += 3   (R2 ist hier immer 0)
512 ; E5 f_tuerkis:   R2 += 1
512 ; E6 f_gruen:
512 ; E7 f_gelb:
512 ; E8 f_orange:
512 ; E9 f_rot:       R2 += 1   -> magenta 8, tuerkis 5, gruen 4, gelb 3, orange 2, rot 1
1E1 ; EA farbe:       R1 = 14: aktive Farbe
CEF ; EB
582 ; EC zurueck:     R2 += 8   (R2 ist hier immer 0)
512 ; ED sichern:     R2 += 1   -> zurueck 9 (peek), sichern 1 (push)
1D1 ; EE              R1 = 13: Stapel
FD0 ; EF cmd:         DIN R0     warten auf REQ
310 ; F0              ANDI 1,R0
EEF ; F1              BRZ
FE1 ; F2              DOT R1     ACK
FE2 ; F3              DOT R2     Nibble 1 (x bzw. Wert)
FE3 ; F4              DOT R3     Nibble 2 (y; bei Befehlen mit 1 Nibble ohne Bedeutung)
102 ; F5              R2 = 0
FE2 ; F6              Ausgaenge auf 0
F07 ; F7              RET
